# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Режим LLM: replay (фикстуры для записи демо) | live (Proxy API)
CASE_LLM=replay

# Proxy API (OpenAI-совместимый). Боевой контур ходит сюда, не напрямую в OpenAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/v1
OPENAI_MODEL=gpt-4o-mini

# Вход боевого контура: files | http | mail
# Сейчас рабочий: files. http и mail — слоты для подключения.
CASE_INPUT=files

# Почта (когда CASE_INPUT=mail)
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FOLDER=INBOX

# Доставка результата менеджеру: file | email | none
# Сейчас рабочий: file (out/). email — слот SMTP.
CASE_NOTIFY=file
MANAGER_EMAIL=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
